# Copy to .env. Any missing key switches that integration to the built-in stand-in (local mode).

# Claude (Anthropic API). Without it a rule-based stand-in makes the same tool calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock (default) | account (development only: uses your local Claude Code login, never an API key). Unset uses the key above if present.
LLM_BACKEND=
# After this moment the model is never called again (hackathon results). ISO date.
LLM_LIVE_UNTIL=2026-12-22T00:00:00+09:00

# PayPal Sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# Use a sandbox business account for this app that is different from any other project.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox buyer used only by scripts/approveSeeds.py
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Server
PORT=3002
DATA_DIR=data
MERCHANT_NAME=Clay Studio
# v2capture or v1sale. Set from the S3 result in VERIFY.md. Never switches at runtime.
REFUND_PATH=v2capture
# Default 6000, or 15000 when LLM_BACKEND=account
AGENT_TIMEOUT_MS=
MAX_SEEDS_PER_SESSION=4
OFFERS_PER_IP_HOUR=40
# Set to 1 to let PUT /api/policy change the merchant layer (never the locked state layer)
ALLOW_POLICY_EDIT=0
# Set to 1 to force every integration into local mode
FORCE_MOCK=0
# Local stand-in switches, for testing the fallback paths: 0 makes the stand-in reject that call
MOCK_V2_REFUND=1
MOCK_SUSPENDED_CANCEL=1
